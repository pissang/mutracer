    <multiply name="fibre_h_across_v" type="float">
      <input name="in1" type="float" nodename="weave_parts_v" output="outy" />
      <input name="in2" type="float" value="30" />
    </multiply>
    <combine2 name="fibre_h_uv_v" type="vector2">
      <input name="in1" type="float" nodename="weave_parts_v" output="outx" />
      <input name="in2" type="float" nodename="fibre_h_across_v" />
    </combine2>
    <multiply name="fibre_h_scaled_v" type="vector2">
      <input name="in1" type="vector2" nodename="fibre_h_uv_v" />
      <input name="in2" type="vector2" value="0.6, 1" />
    </multiply>
    <noise2d name="fibre_h_v" type="float">
      <input name="texcoord" type="vector2" nodename="fibre_h_scaled_v" />
    </noise2d>
    <multiply name="fibre_v_across_v" type="float">
      <input name="in1" type="float" nodename="weave_parts_v" output="outx" />
      <input name="in2" type="float" value="30" />
    </multiply>
    <combine2 name="fibre_v_uv_v" type="vector2">
      <input name="in1" type="float" nodename="fibre_v_across_v" />
      <input name="in2" type="float" nodename="weave_parts_v" output="outy" />
    </combine2>
    <multiply name="fibre_v_scaled_v" type="vector2">
      <input name="in1" type="vector2" nodename="fibre_v_uv_v" />
      <input name="in2" type="vector2" value="1, 0.6" />
    </multiply>
    <noise2d name="fibre_v_v" type="float">
      <input name="texcoord" type="vector2" nodename="fibre_v_scaled_v" />
    </noise2d>
    <mix name="fibre_v_2" type="float">
      <input name="bg" type="float" nodename="fibre_v_v" />
      <input name="fg" type="float" nodename="fibre_h_v" />
      <input name="mix" type="float" nodename="horizontal_on_top_v" />
    </mix>
    <floor name="node_row_v" type="float">
      <input name="in" type="float" nodename="weave_parts_v" output="outy" />
    </floor>
    <combine2 name="node_h_seed_v" type="vector2">
      <input name="in1" type="float" nodename="node_row_v" />
      <input name="in2" type="float" value="3" />
    </combine2>
    <cellnoise2d name="node_h_random_v" type="float">
      <input name="texcoord" type="vector2" nodename="node_h_seed_v" />
    </cellnoise2d>
    <multiply name="node_h_offset_v" type="float">
      <input name="in1" type="float" nodename="node_h_random_v" />
      <input name="in2" type="float" value="1" />
    </multiply>
    <multiply name="node_h_phase_v" type="float">
      <input name="in1" type="float" nodename="weave_parts_v" output="outx" />
      <input name="in2" type="float" value="0.27" />
    </multiply>
    <add name="node_h_seeded_v" type="float">
      <input name="in1" type="float" nodename="node_h_phase_v" />
      <input name="in2" type="float" nodename="node_h_offset_v" />
    </add>
    <floor name="node_h_fraction_floor_v" type="float">
      <input name="in" type="float" nodename="node_h_seeded_v" />
    </floor>
    <subtract name="node_h_fraction_v" type="float">
      <input name="in1" type="float" nodename="node_h_seeded_v" />
      <input name="in2" type="float" nodename="node_h_fraction_floor_v" />
    </subtract>
    <subtract name="node_h_center_v" type="float">
      <input name="in1" type="float" nodename="node_h_fraction_v" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <absval name="node_h_distance_v" type="float">
      <input name="in" type="float" nodename="node_h_center_v" />
    </absval>
    <smoothstep name="node_h_ramp_v" type="float">
      <input name="in" type="float" nodename="node_h_distance_v" />
      <input name="low" type="float" value="0.02" />
      <input name="high" type="float" value="0.06" />
    </smoothstep>
    <invert name="node_h_v" type="float">
      <input name="in" type="float" nodename="node_h_ramp_v" />
    </invert>
    <floor name="node_column_v" type="float">
      <input name="in" type="float" nodename="weave_parts_v" output="outx" />
    </floor>
    <combine2 name="node_v_seed_v" type="vector2">
      <input name="in1" type="float" nodename="node_column_v" />
      <input name="in2" type="float" value="7" />
    </combine2>
    <cellnoise2d name="node_v_random_v" type="float">
      <input name="texcoord" type="vector2" nodename="node_v_seed_v" />
    </cellnoise2d>
    <multiply name="node_v_phase_v" type="float">
      <input name="in1" type="float" nodename="weave_parts_v" output="outy" />
      <input name="in2" type="float" value="0.27" />
    </multiply>
    <add name="node_v_seeded_v" type="float">
      <input name="in1" type="float" nodename="node_v_phase_v" />
      <input name="in2" type="float" nodename="node_v_random_v" />
    </add>
    <floor name="node_v_fraction_floor_v" type="float">
      <input name="in" type="float" nodename="node_v_seeded_v" />
    </floor>
    <subtract name="node_v_fraction_v" type="float">
      <input name="in1" type="float" nodename="node_v_seeded_v" />
      <input name="in2" type="float" nodename="node_v_fraction_floor_v" />
    </subtract>
    <subtract name="node_v_center_v" type="float">
      <input name="in1" type="float" nodename="node_v_fraction_v" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <absval name="node_v_distance_v" type="float">
      <input name="in" type="float" nodename="node_v_center_v" />
    </absval>
    <smoothstep name="node_v_ramp_v" type="float">
      <input name="in" type="float" nodename="node_v_distance_v" />
      <input name="low" type="float" value="0.02" />
      <input name="high" type="float" value="0.06" />
    </smoothstep>
    <invert name="node_v_v" type="float">
      <input name="in" type="float" nodename="node_v_ramp_v" />
    </invert>
    <mix name="nodes_v" type="float">
      <input name="bg" type="float" nodename="node_v_v" />
      <input name="fg" type="float" nodename="node_h_v" />
      <input name="mix" type="float" nodename="horizontal_on_top_v" />
    </mix>
    <floor name="strand_v_index_v" type="float">
      <input name="in" type="float" nodename="weave_parts_v" output="outx" />
    </floor>
    <combine2 name="strand_v_seed_v" type="vector2">
      <input name="in1" type="float" nodename="strand_v_index_v" />
      <input name="in2" type="float" value="11" />
    </combine2>
    <cellnoise2d name="strand_v_random_v" type="float">
      <input name="texcoord" type="vector2" nodename="strand_v_seed_v" />
    </cellnoise2d>
    <floor name="strand_h_index_v" type="float">
      <input name="in" type="float" nodename="weave_parts_v" output="outy" />
    </floor>
    <combine2 name="strand_h_seed_v" type="vector2">
      <input name="in1" type="float" nodename="strand_h_index_v" />
      <input name="in2" type="float" value="5" />
    </combine2>
    <cellnoise2d name="strand_h_random_v" type="float">
      <input name="texcoord" type="vector2" nodename="strand_h_seed_v" />
    </cellnoise2d>
    <mix name="strand_random_v" type="float">
      <input name="bg" type="float" nodename="strand_v_random_v" />
      <input name="fg" type="float" nodename="strand_h_random_v" />
      <input name="mix" type="float" nodename="horizontal_on_top_v" />
    </mix>
    <max name="weave_height_v" type="float">
      <input name="in1" type="float" nodename="h_height_v" />
      <input name="in2" type="float" nodename="v_height_v" />
    </max>
    <multiply name="fibre_height_v" type="float">
      <input name="in1" type="float" nodename="fibre_v_2" />
      <input name="in2" type="float" value="0.05" />
    </multiply>
    <multiply name="node_height_v" type="float">
      <input name="in1" type="float" nodename="nodes_v" />
      <input name="in2" type="float" value="-0.1" />
    </multiply>
    <add name="cane_detail_v" type="float">
      <input name="in1" type="float" nodename="fibre_height_v" />
      <input name="in2" type="float" nodename="node_height_v" />
    </add>
    <multiply name="cane_detail_masked_v" type="float">
      <input name="in1" type="float" nodename="cane_detail_v" />
      <input name="in2" type="float" nodename="strand_mask_v" />
    </multiply>
    <add name="cane_height_v" type="float">
      <input name="in1" type="float" nodename="weave_height_v" />
      <input name="in2" type="float" nodename="cane_detail_masked_v" />
    </add>
    <subtract name="slope_u" type="float">
      <input name="in1" type="float" nodename="cane_height_u" />
      <input name="in2" type="float" nodename="cane_height" />
    </subtract>
    <multiply name="tilt_u" type="float">
      <input name="in1" type="float" nodename="slope_u" />
      <input name="in2" type="float" value="-16.666667" />
    </multiply>
    <subtract name="slope_v" type="float">
      <input name="in1" type="float" nodename="cane_height_v" />
      <input name="in2" type="float" nodename="cane_height" />
    </subtract>
    <multiply name="tilt_v" type="float">
      <input name="in1" type="float" nodename="slope_v" />
      <input name="in2" type="float" value="-16.666667" />
    </multiply>
    <remap name="normal_encoded_u" type="float">
      <input name="in" type="float" nodename="tilt_u" />
      <input name="inlow" type="float" value="-1" />
      <input name="inhigh" type="float" value="1" />
      <input name="outlow" type="float" value="0" />
      <input name="outhigh" type="float" value="1" />
    </remap>
    <remap name="normal_encoded_v" type="float">
      <input name="in" type="float" nodename="tilt_v" />
      <input name="inlow" type="float" value="-1" />
      <input name="inhigh" type="float" value="1" />
      <input name="outlow" type="float" value="0" />
      <input name="outhigh" type="float" value="1" />
    </remap>
    <combine3 name="normal_encoded" type="vector3">
      <input name="in1" type="float" nodename="normal_encoded_u" />
      <input name="in2" type="float" nodename="normal_encoded_v" />
      <input name="in3" type="float" value="1" />
    </combine3>
    <normalmap name="surface_normal" type="vector3">
      <input name="in" type="vector3" nodename="normal_encoded" />
    </normalmap>
    <remap name="height_shade" type="float">
      <input name="in" type="float" nodename="weave_height" />
      <input name="inlow" type="float" value="0" />
      <input name="inhigh" type="float" value="1.35" />
      <input name="outlow" type="float" value="0.35" />
      <input name="outhigh" type="float" value="1.05" />
    </remap>
    <remap name="strand_tone" type="float">
      <input name="in" type="float" nodename="strand_random" />
      <input name="inlow" type="float" value="0" />
      <input name="inhigh" type="float" value="1" />
      <input name="outlow" type="float" value="0.75" />
      <input name="outhigh" type="float" value="1.15" />
    </remap>
    <remap name="fibre_tone" type="float">
      <input name="in" type="float" nodename="fibre" />
      <input name="inlow" type="float" value="-0.5" />
      <input name="inhigh" type="float" value="0.5" />
      <input name="outlow" type="float" value="0.85" />
      <input name="outhigh" type="float" value="1.12" />
    </remap>
    <multiply name="cane_tone" type="float">
      <input name="in1" type="float" nodename="strand_tone" />
      <input name="in2" type="float" nodename="fibre_tone" />
    </multiply>
    <multiply name="cane_toned" type="color3">
      <input name="in1" type="color3" interfacename="cane_color" />
      <input name="in2" type="float" nodename="cane_tone" />
    </multiply>
    <multiply name="cane_shaded" type="color3">
      <input name="in1" type="color3" nodename="cane_toned" />
      <input name="in2" type="float" nodename="height_shade" />
    </multiply>
    <mix name="cane_noded" type="color3">
      <input name="bg" type="color3" nodename="cane_shaded" />
      <input name="fg" type="color3" interfacename="node_color" />
      <input name="mix" type="float" nodename="nodes" />
    </mix>
    <smoothstep name="dive_shade" type="float">
      <input name="in" type="float" nodename="weave_height" />
      <input name="low" type="float" value="0.15" />
      <input name="high" type="float" value="0.75" />
    </smoothstep>
    <mix name="base_color" type="color3">
      <input name="bg" type="color3" interfacename="shadow_color" />
      <input name="fg" type="color3" nodename="cane_noded" />
      <input name="mix" type="float" nodename="dive_shade" />
    </mix>
    <smoothstep name="opacity" type="float">
      <input name="in" type="float" nodename="strand_mask" />
      <input name="low" type="float" value="0.3" />
      <input name="high" type="float" value="0.7" />
    </smoothstep>
    <remap name="roughness" type="float">
      <input name="in" type="float" nodename="fibre" />
      <input name="inlow" type="float" value="-0.5" />
      <input name="inhigh" type="float" value="0.5" />
      <input name="outlow" type="float" value="0.25" />
      <input name="outhigh" type="float" value="0.4" />
    </remap>

    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="surface_normal" />
    <output name="opacity_out" type="float" nodename="opacity" />
  </nodegraph>

  <open_pbr_surface name="SR_rattan" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_rattan" output="base_color_out" />
    <input name="base_diffuse_roughness" type="float" value="0.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_rattan" output="roughness_out" />
    <input name="coat_weight" type="float" value="0.3" />
    <input name="coat_roughness" type="float" value="0.25" />
    <input name="geometry_opacity" type="float" nodegraph="NG_rattan" output="opacity_out" />
    <input name="geometry_normal" type="vector3" nodegraph="NG_rattan" output="normal_out" />
  </open_pbr_surface>
  <surfacematerial name="Rattan" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_rattan" />
  </surfacematerial>
</materialx>
