    <max name="pit_radius_y" type="float">
      <input name="in1" type="float" nodename="pit_radius_raw_y" />
      <input name="in2" type="float" value="0" />
    </max>
    <multiply name="pit_floor_y" type="float">
      <input name="in1" type="float" nodename="pit_radius_y" />
      <input name="in2" type="float" value="0.4" />
    </multiply>
    <add name="pit_rim_y" type="float">
      <input name="in1" type="float" nodename="pit_radius_y" />
      <input name="in2" type="float" value="0.001" />
    </add>
    <smoothstep name="pit_ramp_y" type="float">
      <input name="in" type="float" nodename="pit_distances_y" output="outx" />
      <input name="low" type="float" nodename="pit_floor_y" />
      <input name="high" type="float" nodename="pit_rim_y" />
    </smoothstep>
    <invert name="pit_depth_y" type="float">
      <input name="in" type="float" nodename="pit_ramp_y" />
    </invert>
    <add name="tap_position_z_2" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="0, 0, 0.0003" />
    </add>
    <multiply name="pit_scaled_z" type="vector3">
      <input name="in1" type="vector3" nodename="tap_position_z_2" />
      <input name="in2" type="float" interfacename="rust_scale" />
    </multiply>
    <multiply name="pit_position_z" type="vector3">
      <input name="in1" type="vector3" nodename="pit_scaled_z" />
      <input name="in2" type="float" value="40" />
    </multiply>
    <worleynoise3d name="pits_z" type="vector2">
      <input name="position" type="vector3" nodename="pit_position_z" />
      <input name="jitter" type="float" value="1" />
    </worleynoise3d>
    <separate2 name="pit_distances_z" type="multioutput">
      <input name="in" type="vector2" nodename="pits_z" />
    </separate2>
    <worleynoise3d name="pit_pick_z" type="float">
      <input name="position" type="vector3" nodename="pit_position_z" />
      <input name="jitter" type="float" value="1" />
      <input name="style" type="integer" value="1" />
    </worleynoise3d>
    <subtract name="pit_pick_offset_z" type="float">
      <input name="in1" type="float" nodename="pit_pick_z" />
      <input name="in2" type="float" value="0.6" />
    </subtract>
    <multiply name="pit_radius_raw_z" type="float">
      <input name="in1" type="float" nodename="pit_pick_offset_z" />
      <input name="in2" type="float" value="0.7" />
    </multiply>
    <max name="pit_radius_z" type="float">
      <input name="in1" type="float" nodename="pit_radius_raw_z" />
      <input name="in2" type="float" value="0" />
    </max>
    <multiply name="pit_floor_z" type="float">
      <input name="in1" type="float" nodename="pit_radius_z" />
      <input name="in2" type="float" value="0.4" />
    </multiply>
    <add name="pit_rim_z" type="float">
      <input name="in1" type="float" nodename="pit_radius_z" />
      <input name="in2" type="float" value="0.001" />
    </add>
    <smoothstep name="pit_ramp_z" type="float">
      <input name="in" type="float" nodename="pit_distances_z" output="outx" />
      <input name="low" type="float" nodename="pit_floor_z" />
      <input name="high" type="float" nodename="pit_rim_z" />
    </smoothstep>
    <invert name="pit_depth_z" type="float">
      <input name="in" type="float" nodename="pit_ramp_z" />
    </invert>
    <combine3 name="height_ahead_2" type="vector3">
      <input name="in1" type="float" nodename="pit_depth_x" />
      <input name="in2" type="float" nodename="pit_depth_y" />
      <input name="in3" type="float" nodename="pit_depth_z" />
    </combine3>
    <subtract name="height_delta_2" type="vector3">
      <input name="in1" type="vector3" nodename="height_ahead_2" />
      <input name="in2" type="float" nodename="pit_depth" />
    </subtract>
    <multiply name="height_gradient_2" type="vector3">
      <input name="in1" type="vector3" nodename="height_delta_2" />
      <input name="in2" type="float" value="3333.333333" />
    </multiply>
    <invert name="bare_metal" type="float">
      <input name="in" type="float" nodename="rust_mask" />
    </invert>
    <multiply name="pit_zone" type="float">
      <input name="in1" type="float" nodename="stain_halo" />
      <input name="in2" type="float" nodename="bare_metal" />
    </multiply>
    <multiply name="pit_amount" type="float">
      <input name="in1" type="float" nodename="pit_zone" />
      <input name="in2" type="float" interfacename="pitting" />
    </multiply>
    <multiply name="pit" type="float">
      <input name="in1" type="float" nodename="pit_depth" />
      <input name="in2" type="float" nodename="pit_amount" />
    </multiply>

    <!-- Rust color: dark brown core, orange flakes and ochre crowns, near-black cracks, with fine speckle. -->
    <multiply name="tone_position" type="vector3">
      <input name="in1" type="vector3" nodename="rust_position" />
      <input name="in2" type="float" value="25" />
    </multiply>
    <noise3d name="rust_detail" type="float">
      <input name="position" type="vector3" nodename="tone_position" />
      <input name="amplitude" type="float" value="0.5" />
      <input name="pivot" type="float" value="0.5" />
    </noise3d>
    <subtract name="flake_tone_offset" type="float">
      <input name="in1" type="float" nodename="flake_level" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <multiply name="flake_tone" type="float">
      <input name="in1" type="float" nodename="flake_tone_offset" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="rust_tone_raw" type="float">
      <input name="in1" type="float" nodename="rust_detail" />
      <input name="in2" type="float" nodename="flake_tone" />
    </add>
    <clamp name="rust_tone" type="float">
      <input name="in" type="float" nodename="rust_tone_raw" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <mix name="rust_mottled" type="color3">
      <input name="bg" type="color3" interfacename="rust_dark" />
      <input name="fg" type="color3" interfacename="rust_light" />
      <input name="mix" type="float" nodename="rust_tone" />
    </mix>
    <multiply name="rust_ochre" type="color3">
      <input name="in1" type="color3" interfacename="rust_light" />
      <input name="in2" type="color3" value="1.6, 1.45, 0.9" />
    </multiply>
    <smoothstep name="blister_crown" type="float">
      <input name="in" type="float" nodename="blister" />
      <input name="low" type="float" value="0.5" />
      <input name="high" type="float" value="1" />
    </smoothstep>
    <multiply name="crown_tone" type="float">
      <input name="in1" type="float" nodename="rust_tone" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <multiply name="crown_mix" type="float">
      <input name="in1" type="float" nodename="blister_crown" />
      <input name="in2" type="float" nodename="crown_tone" />
    </multiply>
    <mix name="rust_crowned" type="color3">
      <input name="bg" type="color3" nodename="rust_mottled" />
      <input name="fg" type="color3" nodename="rust_ochre" />
      <input name="mix" type="float" nodename="crown_mix" />
    </mix>
    <multiply name="broad_tone_position" type="vector3">
      <input name="in1" type="vector3" nodename="rust_position" />
      <input name="in2" type="float" value="5" />
    </multiply>
    <fractal3d name="broad_tone_fractal" type="float">
      <input name="position" type="vector3" nodename="broad_tone_position" />
      <input name="octaves" type="integer" value="3" />
    </fractal3d>
    <smoothstep name="broad_tone" type="float">
      <input name="in" type="float" nodename="broad_tone_fractal" />
      <input name="low" type="float" value="-0.25" />
      <input name="high" type="float" value="0.35" />
    </smoothstep>
    <multiply name="core_part" type="float">
      <input name="in1" type="float" nodename="rust_core" />
      <input name="in2" type="float" value="0.45" />
    </multiply>
    <multiply name="broad_part" type="float">
      <input name="in1" type="float" nodename="broad_tone" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="darkening_raw" type="float">
      <input name="in1" type="float" nodename="core_part" />
      <input name="in2" type="float" nodename="broad_part" />
    </add>
    <clamp name="rust_darkening" type="float">
      <input name="in" type="float" nodename="darkening_raw" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="0.85" />
    </clamp>
    <multiply name="rust_brown" type="color3">
      <input name="in1" type="color3" interfacename="rust_dark" />
      <input name="in2" type="float" value="1.3" />
    </multiply>
    <mix name="rust_cored" type="color3">
      <input name="bg" type="color3" nodename="rust_crowned" />
      <input name="fg" type="color3" nodename="rust_brown" />
      <input name="mix" type="float" nodename="rust_darkening" />
    </mix>
    <multiply name="crack_color" type="color3">
      <input name="in1" type="color3" interfacename="rust_dark" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <mix name="rust_cracked" type="color3">
      <input name="bg" type="color3" nodename="crack_color" />
      <input name="fg" type="color3" nodename="rust_cored" />
      <input name="mix" type="float" nodename="flake_crack" />
    </mix>
    <multiply name="speck_position" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="float" value="420" />
    </multiply>
    <cellnoise3d name="speck" type="float">
      <input name="position" type="vector3" nodename="speck_position" />
    </cellnoise3d>
    <remap name="speck_tone" type="float">
      <input name="in" type="float" nodename="speck" />
      <input name="inlow" type="float" value="0" />
      <input name="inhigh" type="float" value="1" />
      <input name="outlow" type="float" value="0.75" />
      <input name="outhigh" type="float" value="1.2" />
    </remap>
    <multiply name="rust_color" type="color3">
      <input name="in1" type="color3" nodename="rust_cracked" />
      <input name="in2" type="float" nodename="speck_tone" />
    </multiply>

    <!-- Bare steel: brushed along object X, stained brown around the patches and dark in the pits. -->
    <multiply name="brush_position" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="1.5, 90, 90" />
    </multiply>
    <noise3d name="brush_noise" type="float">
      <input name="position" type="vector3" nodename="brush_position" />
      <input name="amplitude" type="float" value="0.07" />
      <input name="pivot" type="float" value="0.26" />
    </noise3d>
    <multiply name="brush_fine_position" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="4, 600, 600" />
    </multiply>
    <noise3d name="brush_fine" type="float">
      <input name="position" type="vector3" nodename="brush_fine_position" />
    </noise3d>
    <multiply name="brush_tone_offset" type="float">
      <input name="in1" type="float" nodename="brush_fine" />
      <input name="in2" type="float" value="0.12" />
    </multiply>
    <add name="brush_tone" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="brush_tone_offset" />
    </add>
    <multiply name="metal_toned" type="color3">
      <input name="in1" type="color3" interfacename="metal_color" />
      <input name="in2" type="float" nodename="brush_tone" />
    </multiply>
    <multiply name="stain_amount" type="float">
      <input name="in1" type="float" nodename="stain_halo" />
      <input name="in2" type="float" value="0.75" />
    </multiply>
    <multiply name="stain_color" type="color3">
      <input name="in1" type="color3" interfacename="metal_color" />
      <input name="in2" type="color3" value="0.6, 0.4, 0.27" />
    </multiply>
    <mix name="stained_metal" type="color3">
      <input name="bg" type="color3" nodename="metal_toned" />
      <input name="fg" type="color3" nodename="stain_color" />
      <input name="mix" type="float" nodename="stain_amount" />
    </mix>
    <multiply name="pit_color" type="color3">
      <input name="in1" type="color3" interfacename="rust_dark" />
      <input name="in2" type="float" value="2" />
    </multiply>
    <multiply name="pit_color_amount" type="float">
      <input name="in1" type="float" nodename="pit" />
      <input name="in2" type="float" value="3" />
    </multiply>
    <clamp name="pit_color_mix" type="float">
      <input name="in" type="float" nodename="pit_color_amount" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <mix name="pitted_metal" type="color3">
      <input name="bg" type="color3" nodename="stained_metal" />
      <input name="fg" type="color3" nodename="pit_color" />
      <input name="mix" type="float" nodename="pit_color_mix" />
    </mix>
    <mix name="base_color" type="color3">
      <input name="bg" type="color3" nodename="pitted_metal" />
      <input name="fg" type="color3" nodename="rust_color" />
      <input name="mix" type="float" nodename="rust_mask" />
    </mix>
    <clamp name="pit_dielectric" type="float">
      <input name="in" type="float" nodename="pit" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <max name="dielectric" type="float">
      <input name="in1" type="float" nodename="rust_mask" />
      <input name="in2" type="float" nodename="pit_dielectric" />
    </max>
    <invert name="metalness" type="float">
      <input name="in" type="float" nodename="dielectric" />
    </invert>
    <multiply name="stain_roughness" type="float">
      <input name="in1" type="float" nodename="stain_halo" />
      <input name="in2" type="float" value="0.22" />
    </multiply>
    <add name="metal_stained_roughness" type="float">
      <input name="in1" type="float" nodename="brush_noise" />
      <input name="in2" type="float" nodename="stain_roughness" />
    </add>
    <multiply name="pit_roughness" type="float">
      <input name="in1" type="float" nodename="pit" />
      <input name="in2" type="float" value="0.4" />
    </multiply>
    <add name="metal_roughness" type="float">
      <input name="in1" type="float" nodename="metal_stained_roughness" />
      <input name="in2" type="float" nodename="pit_roughness" />
    </add>
    <remap name="rust_roughness" type="float">
      <input name="in" type="float" nodename="crust" />
      <input name="inlow" type="float" value="0" />
      <input name="inhigh" type="float" value="1" />
      <input name="outlow" type="float" value="0.95" />
      <input name="outhigh" type="float" value="0.72" />
    </remap>
    <mix name="roughness" type="float">
      <input name="bg" type="float" nodename="metal_roughness" />
      <input name="fg" type="float" nodename="rust_roughness" />
      <input name="mix" type="float" nodename="rust_mask" />
    </mix>
    <multiply name="anisotropy" type="float">
      <input name="in1" type="float" nodename="metalness" />
      <input name="in2" type="float" interfacename="brushing" />
    </multiply>
    <multiply name="crust_strength" type="float">
      <input name="in1" type="float" interfacename="pitting" />
      <input name="in2" type="float" value="0.012" />
    </multiply>
    <multiply name="crust_bump" type="float">
      <input name="in1" type="float" nodename="rust_mask" />
      <input name="in2" type="float" nodename="crust_strength" />
    </multiply>
    <multiply name="crust_gradient" type="vector3">
      <input name="in1" type="vector3" nodename="height_gradient" />
      <input name="in2" type="float" nodename="crust_bump" />
    </multiply>
    <multiply name="pit_strength" type="float">
      <input name="in1" type="float" nodename="pit_amount" />
      <input name="in2" type="float" value="0.0015" />
    </multiply>
    <multiply name="pit_gradient" type="vector3">
      <input name="in1" type="vector3" nodename="height_gradient_2" />
      <input name="in2" type="float" nodename="pit_strength" />
    </multiply>
    <add name="pitted_gradient_sum" type="vector3">
      <input name="in1" type="vector3" nodename="crust_gradient" />
      <input name="in2" type="vector3" nodename="pit_gradient" />
    </add>
    <dotproduct name="pitted_along_normal" type="float">
      <input name="in1" type="vector3" nodename="pitted_gradient_sum" />
      <input name="in2" type="vector3" nodename="object_normal" />
    </dotproduct>
    <multiply name="pitted_normal_part" type="vector3">
      <input name="in1" type="vector3" nodename="object_normal" />
      <input name="in2" type="float" nodename="pitted_along_normal" />
    </multiply>
    <subtract name="pitted_surface_gradient" type="vector3">
      <input name="in1" type="vector3" nodename="pitted_gradient_sum" />
      <input name="in2" type="vector3" nodename="pitted_normal_part" />
    </subtract>
    <subtract name="pitted_object" type="vector3">
      <input name="in1" type="vector3" nodename="object_normal" />
      <input name="in2" type="vector3" nodename="pitted_surface_gradient" />
    </subtract>
    <transformnormal name="pitted_world" type="vector3">
      <input name="in" type="vector3" nodename="pitted_object" />
      <input name="fromspace" type="string" value="object" />
      <input name="tospace" type="string" value="world" />
    </transformnormal>
    <normalize name="pitted_normal" type="vector3">
      <input name="in" type="vector3" nodename="pitted_world" />
    </normalize>

    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="anisotropy_out" type="float" nodename="anisotropy" />
    <output name="normal_out" type="vector3" nodename="pitted_normal" />
  </nodegraph>

  <open_pbr_surface name="SR_weathered_steel" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_weathered_steel" output="base_color_out" />
    <input name="base_metalness" type="float" nodegraph="NG_weathered_steel" output="metalness_out" />
    <input name="base_diffuse_roughness" type="float" value="0.6" />
    <input name="specular_roughness" type="float" nodegraph="NG_weathered_steel" output="roughness_out" />
    <input name="specular_roughness_anisotropy" type="float" nodegraph="NG_weathered_steel" output="anisotropy_out" />
    <input name="geometry_normal" type="vector3" nodegraph="NG_weathered_steel" output="normal_out" />
  </open_pbr_surface>
  <surfacematerial name="Weathered_Steel" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_weathered_steel" />
  </surfacematerial>
</materialx>
