<?xml version="1.0"?>
<!--
  Weathered steel: OpenPBR brushed metal with rust patches. A fractal mask,
  frayed at two finer scales, blends rust over the metal. The rust is a
  crust of layered flakes split by dark cracks, with fractal scale and fine
  blisters whose ochre crowns stand out of orange and dark brown; it is
  rough and dielectric. Around each patch a brown stain bleeds into the
  steel and small corrosion pits open; the bare metal keeps anisotropic
  brushing. Object-space finite differences of the heights give the normal.
  Procedural, CC0.
-->
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_weathered_steel">
    <input name="metal_color" type="color3" value="0.56, 0.57, 0.58" uiname="Metal color" />
    <input name="rust_dark" type="color3" value="0.04, 0.013, 0.006" uiname="Dark rust" />
    <input name="rust_light" type="color3" value="0.26, 0.07, 0.016" uiname="Light rust" />
    <input name="rust_amount" type="float" value="0.42" uiname="Rust amount" uimin="0" uimax="1" />
    <input name="rust_scale" type="float" value="2.2" uiname="Rust scale" />
    <input name="edge_width" type="float" value="0.02" uiname="Edge width" uimin="0.005" uimax="0.3" />
    <input name="pitting" type="float" value="0.5" uiname="Pitting" uimin="0" uimax="1" />
    <input name="brushing" type="float" value="0.6" uiname="Brushing" uimin="0" uimax="1" />
    <position name="object_position" type="vector3" />
    <normal name="object_normal" type="vector3" />
    <multiply name="rust_position" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="float" interfacename="rust_scale" />
    </multiply>

    <!-- Rust mask: a fractal field frayed at two finer scales, so the patch edges stay ragged up close. -->
    <fractal3d name="rust_fractal" type="float">
      <input name="position" type="vector3" nodename="rust_position" />
      <input name="octaves" type="integer" value="5" />
    </fractal3d>
    <remap name="rust_base_field" type="float">
      <input name="in" type="float" nodename="rust_fractal" />
      <input name="inlow" type="float" value="-0.7" />
      <input name="inhigh" type="float" value="0.7" />
      <input name="outlow" type="float" value="0" />
      <input name="outhigh" type="float" value="1" />
    </remap>
    <multiply name="fray_position" type="vector3">
      <input name="in1" type="vector3" nodename="rust_position" />
      <input name="in2" type="float" value="9" />
    </multiply>
    <noise3d name="edge_fray" type="float">
      <input name="position" type="vector3" nodename="fray_position" />
      <input name="amplitude" type="float" value="0.07" />
    </noise3d>
    <add name="rust_frayed" type="float">
      <input name="in1" type="float" nodename="rust_base_field" />
      <input name="in2" type="float" nodename="edge_fray" />
    </add>
    <multiply name="fine_fray_position" type="vector3">
      <input name="in1" type="vector3" nodename="rust_position" />
      <input name="in2" type="float" value="37" />
    </multiply>
    <noise3d name="edge_fine_fray" type="float">
      <input name="position" type="vector3" nodename="fine_fray_position" />
      <input name="amplitude" type="float" value="0.035" />
    </noise3d>
    <add name="rust_field" type="float">
      <input name="in1" type="float" nodename="rust_frayed" />
      <input name="in2" type="float" nodename="edge_fine_fray" />
    </add>
    <invert name="rust_threshold" type="float">
      <input name="in" type="float" interfacename="rust_amount" />
    </invert>
    <subtract name="edge_low" type="float">
      <input name="in1" type="float" nodename="rust_threshold" />
      <input name="in2" type="float" interfacename="edge_width" />
    </subtract>
    <add name="edge_high" type="float">
      <input name="in1" type="float" nodename="rust_threshold" />
      <input name="in2" type="float" interfacename="edge_width" />
    </add>
    <smoothstep name="rust_mask" type="float">
      <input name="in" type="float" nodename="rust_field" />
      <input name="low" type="float" nodename="edge_low" />
      <input name="high" type="float" nodename="edge_high" />
    </smoothstep>
    <add name="core_high" type="float">
      <input name="in1" type="float" nodename="rust_threshold" />
      <input name="in2" type="float" value="0.28" />
    </add>
    <smoothstep name="rust_core" type="float">
      <input name="in" type="float" nodename="rust_field" />
      <input name="low" type="float" nodename="rust_threshold" />
      <input name="high" type="float" nodename="core_high" />
    </smoothstep>
    <subtract name="stain_low" type="float">
      <input name="in1" type="float" nodename="rust_threshold" />
      <input name="in2" type="float" value="0.2" />
    </subtract>
    <smoothstep name="stain_halo" type="float">
      <input name="in" type="float" nodename="rust_field" />
      <input name="low" type="float" nodename="stain_low" />
      <input name="high" type="float" nodename="rust_threshold" />
    </smoothstep>
    <multiply name="crust_scaled" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="float" interfacename="rust_scale" />
    </multiply>
    <multiply name="flake_warp_position" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled" />
      <input name="in2" type="float" value="3" />
    </multiply>
    <noise3d name="flake_warp" type="vector3">
      <input name="position" type="vector3" nodename="flake_warp_position" />
    </noise3d>
    <multiply name="flake_grid" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled" />
      <input name="in2" type="float" value="6" />
    </multiply>
    <multiply name="flake_warp_offset" type="vector3">
      <input name="in1" type="vector3" nodename="flake_warp" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="flake_position" type="vector3">
      <input name="in1" type="vector3" nodename="flake_grid" />
      <input name="in2" type="vector3" nodename="flake_warp_offset" />
    </add>
    <worleynoise3d name="flakes" type="vector2">
      <input name="position" type="vector3" nodename="flake_position" />
      <input name="jitter" type="float" value="0.9" />
    </worleynoise3d>
    <separate2 name="flake_distances" type="multioutput">
      <input name="in" type="vector2" nodename="flakes" />
    </separate2>
    <worleynoise3d name="flake_lift" type="float">
      <input name="position" type="vector3" nodename="flake_position" />
      <input name="jitter" type="float" value="0.9" />
      <input name="style" type="integer" value="1" />
    </worleynoise3d>
    <multiply name="crack_zone_position" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled" />
      <input name="in2" type="float" value="4" />
    </multiply>
    <noise3d name="crack_zone_noise" type="float">
      <input name="position" type="vector3" nodename="crack_zone_position" />
    </noise3d>
    <smoothstep name="crack_zone" type="float">
      <input name="in" type="float" nodename="crack_zone_noise" />
      <input name="low" type="float" value="-0.12" />
      <input name="high" type="float" value="0.15" />
    </smoothstep>
    <subtract name="flake_border" type="float">
      <input name="in1" type="float" nodename="flake_distances" output="outy" />
      <input name="in2" type="float" nodename="flake_distances" output="outx" />
    </subtract>
    <smoothstep name="flake_border_ramp" type="float">
      <input name="in" type="float" nodename="flake_border" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="0.035" />
    </smoothstep>
    <invert name="crack_line" type="float">
      <input name="in" type="float" nodename="flake_border_ramp" />
    </invert>
    <multiply name="crack_zoned" type="float">
      <input name="in1" type="float" nodename="crack_line" />
      <input name="in2" type="float" nodename="crack_zone" />
    </multiply>
    <invert name="flake_crack" type="float">
      <input name="in" type="float" nodename="crack_zoned" />
    </invert>
    <invert name="flake_drop" type="float">
      <input name="in" type="float" nodename="flake_lift" />
    </invert>
    <multiply name="zone_drop" type="float">
      <input name="in1" type="float" nodename="crack_zone" />
      <input name="in2" type="float" value="0.7" />
    </multiply>
    <multiply name="flake_sink" type="float">
      <input name="in1" type="float" nodename="flake_drop" />
      <input name="in2" type="float" nodename="zone_drop" />
    </multiply>
    <invert name="flake_level" type="float">
      <input name="in" type="float" nodename="flake_sink" />
    </invert>
    <multiply name="scale_position" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled" />
      <input name="in2" type="float" value="18" />
    </multiply>
    <fractal3d name="scale_relief" type="float">
      <input name="position" type="vector3" nodename="scale_position" />
      <input name="octaves" type="integer" value="5" />
    </fractal3d>
    <multiply name="blister_position" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled" />
      <input name="in2" type="float" value="45" />
    </multiply>
    <worleynoise3d name="blisters" type="vector2">
      <input name="position" type="vector3" nodename="blister_position" />
    </worleynoise3d>
    <separate2 name="blister_distances" type="multioutput">
      <input name="in" type="vector2" nodename="blisters" />
    </separate2>
    <multiply name="blister_size_position" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled" />
      <input name="in2" type="float" value="30" />
    </multiply>
    <noise3d name="blister_size_noise" type="float">
      <input name="position" type="vector3" nodename="blister_size_position" />
    </noise3d>
    <remap name="blister_size" type="float">
      <input name="in" type="float" nodename="blister_size_noise" />
      <input name="inlow" type="float" value="-0.5" />
      <input name="inhigh" type="float" value="0.5" />
      <input name="outlow" type="float" value="0.25" />
      <input name="outhigh" type="float" value="0.9" />
    </remap>
    <smoothstep name="blister_ramp" type="float">
      <input name="in" type="float" nodename="blister_distances" output="outx" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" nodename="blister_size" />
    </smoothstep>
    <invert name="blister" type="float">
      <input name="in" type="float" nodename="blister_ramp" />
    </invert>
    <multiply name="grain_position" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled" />
      <input name="in2" type="float" value="160" />
    </multiply>
    <noise3d name="grain" type="float">
      <input name="position" type="vector3" nodename="grain_position" />
    </noise3d>
    <multiply name="flake_shape" type="float">
      <input name="in1" type="float" nodename="flake_crack" />
      <input name="in2" type="float" nodename="flake_level" />
    </multiply>
    <multiply name="flake_height" type="float">
      <input name="in1" type="float" nodename="flake_shape" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <multiply name="scale_height" type="float">
      <input name="in1" type="float" nodename="scale_relief" />
      <input name="in2" type="float" value="0.3" />
    </multiply>
    <add name="crust_scale" type="float">
      <input name="in1" type="float" nodename="flake_height" />
      <input name="in2" type="float" nodename="scale_height" />
    </add>
    <multiply name="blister_height" type="float">
      <input name="in1" type="float" nodename="blister" />
      <input name="in2" type="float" value="0.22" />
    </multiply>
    <add name="crust_blistered" type="float">
      <input name="in1" type="float" nodename="crust_scale" />
      <input name="in2" type="float" nodename="blister_height" />
    </add>
    <multiply name="grain_height" type="float">
      <input name="in1" type="float" nodename="grain" />
      <input name="in2" type="float" value="0.08" />
    </multiply>
    <add name="crust" type="float">
      <input name="in1" type="float" nodename="crust_blistered" />
      <input name="in2" type="float" nodename="grain_height" />
    </add>
    <add name="tap_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="0.0004, 0, 0" />
    </add>
    <multiply name="crust_scaled_x" type="vector3">
      <input name="in1" type="vector3" nodename="tap_position_x" />
      <input name="in2" type="float" interfacename="rust_scale" />
    </multiply>
    <multiply name="flake_warp_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_x" />
      <input name="in2" type="float" value="3" />
    </multiply>
    <noise3d name="flake_warp_x" type="vector3">
      <input name="position" type="vector3" nodename="flake_warp_position_x" />
    </noise3d>
    <multiply name="flake_grid_x" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_x" />
      <input name="in2" type="float" value="6" />
    </multiply>
    <multiply name="flake_warp_offset_x" type="vector3">
      <input name="in1" type="vector3" nodename="flake_warp_x" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="flake_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="flake_grid_x" />
      <input name="in2" type="vector3" nodename="flake_warp_offset_x" />
    </add>
    <worleynoise3d name="flakes_x" type="vector2">
      <input name="position" type="vector3" nodename="flake_position_x" />
      <input name="jitter" type="float" value="0.9" />
    </worleynoise3d>
    <separate2 name="flake_distances_x" type="multioutput">
      <input name="in" type="vector2" nodename="flakes_x" />
    </separate2>
    <worleynoise3d name="flake_lift_x" type="float">
      <input name="position" type="vector3" nodename="flake_position_x" />
      <input name="jitter" type="float" value="0.9" />
      <input name="style" type="integer" value="1" />
    </worleynoise3d>
    <multiply name="crack_zone_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_x" />
      <input name="in2" type="float" value="4" />
    </multiply>
    <noise3d name="crack_zone_noise_x" type="float">
      <input name="position" type="vector3" nodename="crack_zone_position_x" />
    </noise3d>
    <smoothstep name="crack_zone_x" type="float">
      <input name="in" type="float" nodename="crack_zone_noise_x" />
      <input name="low" type="float" value="-0.12" />
      <input name="high" type="float" value="0.15" />
    </smoothstep>
    <subtract name="flake_border_x" type="float">
      <input name="in1" type="float" nodename="flake_distances_x" output="outy" />
      <input name="in2" type="float" nodename="flake_distances_x" output="outx" />
    </subtract>
    <smoothstep name="flake_border_ramp_x" type="float">
      <input name="in" type="float" nodename="flake_border_x" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="0.035" />
    </smoothstep>
    <invert name="crack_line_x" type="float">
      <input name="in" type="float" nodename="flake_border_ramp_x" />
    </invert>
    <multiply name="crack_zoned_x" type="float">
      <input name="in1" type="float" nodename="crack_line_x" />
      <input name="in2" type="float" nodename="crack_zone_x" />
    </multiply>
    <invert name="flake_crack_x" type="float">
      <input name="in" type="float" nodename="crack_zoned_x" />
    </invert>
    <invert name="flake_drop_x" type="float">
      <input name="in" type="float" nodename="flake_lift_x" />
    </invert>
    <multiply name="zone_drop_x" type="float">
      <input name="in1" type="float" nodename="crack_zone_x" />
      <input name="in2" type="float" value="0.7" />
    </multiply>
    <multiply name="flake_sink_x" type="float">
      <input name="in1" type="float" nodename="flake_drop_x" />
      <input name="in2" type="float" nodename="zone_drop_x" />
    </multiply>
    <invert name="flake_level_x" type="float">
      <input name="in" type="float" nodename="flake_sink_x" />
    </invert>
    <multiply name="scale_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_x" />
      <input name="in2" type="float" value="18" />
    </multiply>
    <fractal3d name="scale_relief_x" type="float">
      <input name="position" type="vector3" nodename="scale_position_x" />
      <input name="octaves" type="integer" value="5" />
    </fractal3d>
    <multiply name="blister_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_x" />
      <input name="in2" type="float" value="45" />
    </multiply>
    <worleynoise3d name="blisters_x" type="vector2">
      <input name="position" type="vector3" nodename="blister_position_x" />
    </worleynoise3d>
    <separate2 name="blister_distances_x" type="multioutput">
      <input name="in" type="vector2" nodename="blisters_x" />
    </separate2>
    <multiply name="blister_size_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_x" />
      <input name="in2" type="float" value="30" />
    </multiply>
    <noise3d name="blister_size_noise_x" type="float">
      <input name="position" type="vector3" nodename="blister_size_position_x" />
    </noise3d>
    <remap name="blister_size_x" type="float">
      <input name="in" type="float" nodename="blister_size_noise_x" />
      <input name="inlow" type="float" value="-0.5" />
      <input name="inhigh" type="float" value="0.5" />
      <input name="outlow" type="float" value="0.25" />
      <input name="outhigh" type="float" value="0.9" />
    </remap>
    <smoothstep name="blister_ramp_x" type="float">
      <input name="in" type="float" nodename="blister_distances_x" output="outx" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" nodename="blister_size_x" />
    </smoothstep>
    <invert name="blister_x" type="float">
      <input name="in" type="float" nodename="blister_ramp_x" />
    </invert>
    <multiply name="grain_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_x" />
      <input name="in2" type="float" value="160" />
    </multiply>
    <noise3d name="grain_x" type="float">
      <input name="position" type="vector3" nodename="grain_position_x" />
    </noise3d>
    <multiply name="flake_shape_x" type="float">
      <input name="in1" type="float" nodename="flake_crack_x" />
      <input name="in2" type="float" nodename="flake_level_x" />
    </multiply>
    <multiply name="flake_height_x" type="float">
      <input name="in1" type="float" nodename="flake_shape_x" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <multiply name="scale_height_x" type="float">
      <input name="in1" type="float" nodename="scale_relief_x" />
      <input name="in2" type="float" value="0.3" />
    </multiply>
    <add name="crust_scale_x" type="float">
      <input name="in1" type="float" nodename="flake_height_x" />
      <input name="in2" type="float" nodename="scale_height_x" />
    </add>
    <multiply name="blister_height_x" type="float">
      <input name="in1" type="float" nodename="blister_x" />
      <input name="in2" type="float" value="0.22" />
    </multiply>
    <add name="crust_blistered_x" type="float">
      <input name="in1" type="float" nodename="crust_scale_x" />
      <input name="in2" type="float" nodename="blister_height_x" />
    </add>
    <multiply name="grain_height_x" type="float">
      <input name="in1" type="float" nodename="grain_x" />
      <input name="in2" type="float" value="0.08" />
    </multiply>
    <add name="crust_x" type="float">
      <input name="in1" type="float" nodename="crust_blistered_x" />
      <input name="in2" type="float" nodename="grain_height_x" />
    </add>
    <add name="tap_position_y" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="0, 0.0004, 0" />
    </add>
    <multiply name="crust_scaled_y" type="vector3">
      <input name="in1" type="vector3" nodename="tap_position_y" />
      <input name="in2" type="float" interfacename="rust_scale" />
    </multiply>
    <multiply name="flake_warp_position_y" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_y" />
      <input name="in2" type="float" value="3" />
    </multiply>
    <noise3d name="flake_warp_y" type="vector3">
      <input name="position" type="vector3" nodename="flake_warp_position_y" />
    </noise3d>
    <multiply name="flake_grid_y" type="vector3">
      <input name="in1" type="vector3" nodename="crust_scaled_y" />
      <input name="in2" type="float" value="6" />
    </multiply>
    <multiply name="flake_warp_offset_y" type="vector3">
      <input name="in1" type="vector3" nodename="flake_warp_y" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="flake_position_y" type="vector3">
      <input name="in1" type="vector3" nodename="flake_grid_y" />
      <input name="in2" type="vector3" nodename="flake_warp_offset_y" />
    </add>
    <worleynoise3d name="flakes_y" type="vector2">
      <input name="position" type="vector3" nodename="flake_position_y" />
