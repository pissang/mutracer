<?xml version="1.0"?>
<!--
  Varnished wood: OpenPBR with growth rings around the object Y axis. A
  fractal warps the ring distance; modulo and smoothstep shape early and
  late wood, a three-stop ramp colors it. Fine grain noise becomes a bump:
  its gradient comes from finite differences and tilts the object-space
  normal, which is then transformed to world space. A clear varnish coat
  sits on top. Procedural, CC0.
-->
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_varnished_wood">
    <input name="earlywood" type="color3" value="0.52, 0.29, 0.13" uiname="Earlywood" />
    <input name="latewood" type="color3" value="0.2, 0.08, 0.025" uiname="Latewood" />
    <input name="heartwood" type="color3" value="0.36, 0.17, 0.065" uiname="Heartwood tint" />
    <input name="ring_density" type="float" value="9" uiname="Rings per unit" />
    <input name="distortion" type="float" value="0.3" uiname="Ring distortion" />
    <input name="grain_bump" type="float" value="0.004" uiname="Grain bump" />

    <position name="object_position" type="vector3" />
    <normal name="object_normal" type="vector3" />

    <!-- Ring distance from the Y axis, warped by fractal noise. -->
    <multiply name="radial_mask" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="1, 0, 1" />
    </multiply>
    <dotproduct name="radius_squared" type="float">
      <input name="in1" type="vector3" nodename="radial_mask" />
      <input name="in2" type="vector3" nodename="radial_mask" />
    </dotproduct>
    <sqrt name="radius" type="float">
      <input name="in" type="float" nodename="radius_squared" />
    </sqrt>
    <multiply name="warp_position" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="1.2, 0.25, 1.2" />
    </multiply>
    <fractal3d name="warp" type="float">
      <input name="position" type="vector3" nodename="warp_position" />
      <input name="octaves" type="integer" value="4" />
      <input name="amplitude" type="float" interfacename="distortion" />
    </fractal3d>
    <add name="warped_radius" type="float">
      <input name="in1" type="float" nodename="radius" />
      <input name="in2" type="float" nodename="warp" />
    </add>
    <multiply name="ring_phase" type="float">
      <input name="in1" type="float" nodename="warped_radius" />
      <input name="in2" type="float" interfacename="ring_density" />
    </multiply>
    <modulo name="ring" type="float">
      <input name="in1" type="float" nodename="ring_phase" />
      <input name="in2" type="float" value="1" />
    </modulo>
    <smoothstep name="late_mask" type="float">
      <input name="in" type="float" nodename="ring" />
      <input name="low" type="float" value="0.6" />
      <input name="high" type="float" value="0.92" />
    </smoothstep>

    <!-- Three-stop ramp: earlywood, heartwood tint, latewood. -->
    <smoothstep name="ramp_low" type="float">
      <input name="in" type="float" nodename="late_mask" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="0.5" />
    </smoothstep>
    <smoothstep name="ramp_high" type="float">
      <input name="in" type="float" nodename="late_mask" />
      <input name="low" type="float" value="0.5" />
      <input name="high" type="float" value="1" />
    </smoothstep>
    <mix name="ramp_first" type="color3">
      <input name="bg" type="color3" interfacename="earlywood" />
      <input name="fg" type="color3" interfacename="heartwood" />
      <input name="mix" type="float" nodename="ramp_low" />
    </mix>
    <mix name="ring_color" type="color3">
      <input name="bg" type="color3" nodename="ramp_first" />
      <input name="fg" type="color3" interfacename="latewood" />
      <input name="mix" type="float" nodename="ramp_high" />
    </mix>

    <!-- Grain: noise stretched along the trunk axis. -->
    <multiply name="grain_position" type="vector3">
      <input name="in1" type="vector3" nodename="object_position" />
      <input name="in2" type="vector3" value="70, 3, 70" />
    </multiply>
    <noise3d name="grain" type="float">
      <input name="position" type="vector3" nodename="grain_position" />
    </noise3d>
    <remap name="grain_shade" type="float">
      <input name="in" type="float" nodename="grain" />
      <input name="inlow" type="float" value="-1" />
      <input name="inhigh" type="float" value="1" />
      <input name="outlow" type="float" value="0.8" />
      <input name="outhigh" type="float" value="1.1" />
    </remap>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="ring_color" />
      <input name="in2" type="float" nodename="grain_shade" />
    </multiply>
    <mix name="roughness" type="float">
      <input name="bg" type="float" value="0.55" />
      <input name="fg" type="float" value="0.38" />
      <input name="mix" type="float" nodename="late_mask" />
    </mix>

    <!-- Bump from the grain height: forward differences in noise space. -->
    <add name="grain_position_x" type="vector3">
      <input name="in1" type="vector3" nodename="grain_position" />
      <input name="in2" type="vector3" value="0.05, 0, 0" />
    </add>
    <add name="grain_position_y" type="vector3">
      <input name="in1" type="vector3" nodename="grain_position" />
      <input name="in2" type="vector3" value="0, 0.05, 0" />
    </add>
    <add name="grain_position_z" type="vector3">
      <input name="in1" type="vector3" nodename="grain_position" />
      <input name="in2" type="vector3" value="0, 0, 0.05" />
    </add>
    <noise3d name="grain_x" type="float">
      <input name="position" type="vector3" nodename="grain_position_x" />
    </noise3d>
    <noise3d name="grain_y" type="float">
      <input name="position" type="vector3" nodename="grain_position_y" />
    </noise3d>
    <noise3d name="grain_z" type="float">
      <input name="position" type="vector3" nodename="grain_position_z" />
    </noise3d>
    <combine3 name="grain_ahead" type="vector3">
      <input name="in1" type="float" nodename="grain_x" />
      <input name="in2" type="float" nodename="grain_y" />
      <input name="in3" type="float" nodename="grain_z" />
    </combine3>
    <subtract name="grain_delta" type="vector3">
      <input name="in1" type="vector3" nodename="grain_ahead" />
      <input name="in2" type="float" nodename="grain" />
    </subtract>
    <!-- d(noise)/d(position) = delta / step * stretch. -->
    <multiply name="grain_gradient" type="vector3">
      <input name="in1" type="vector3" nodename="grain_delta" />
      <input name="in2" type="vector3" value="1400, 60, 1400" />
    </multiply>
    <dotproduct name="gradient_along_normal" type="float">
      <input name="in1" type="vector3" nodename="grain_gradient" />
      <input name="in2" type="vector3" nodename="object_normal" />
    </dotproduct>
    <multiply name="gradient_normal_part" type="vector3">
      <input name="in1" type="vector3" nodename="object_normal" />
      <input name="in2" type="float" nodename="gradient_along_normal" />
    </multiply>
    <subtract name="surface_gradient" type="vector3">
      <input name="in1" type="vector3" nodename="grain_gradient" />
      <input name="in2" type="vector3" nodename="gradient_normal_part" />
    </subtract>
    <multiply name="bump_offset" type="vector3">
      <input name="in1" type="vector3" nodename="surface_gradient" />
      <input name="in2" type="float" interfacename="grain_bump" />
    </multiply>
    <subtract name="bumped_object_normal" type="vector3">
      <input name="in1" type="vector3" nodename="object_normal" />
      <input name="in2" type="vector3" nodename="bump_offset" />
    </subtract>
    <transformnormal name="bumped_world_normal" type="vector3">
      <input name="in" type="vector3" nodename="bumped_object_normal" />
      <input name="fromspace" type="string" value="object" />
      <input name="tospace" type="string" value="world" />
    </transformnormal>
    <normalize name="bumped_normal" type="vector3">
      <input name="in" type="vector3" nodename="bumped_world_normal" />
    </normalize>

    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="bumped_normal" />
  </nodegraph>

  <open_pbr_surface name="SR_varnished_wood" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_varnished_wood" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_varnished_wood" output="roughness_out" />
    <input name="coat_weight" type="float" value="0.85" />
    <input name="coat_roughness" type="float" value="0.06" />
    <input name="coat_color" type="color3" value="0.96, 0.9, 0.78" />
    <input name="geometry_normal" type="vector3" nodegraph="NG_varnished_wood" output="normal_out" />
  </open_pbr_surface>
  <surfacematerial name="Varnished_Wood" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_varnished_wood" />
  </surfacematerial>
</materialx>
