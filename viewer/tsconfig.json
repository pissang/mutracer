{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": "..",
    "paths": {
      "@meimu/mutracer": ["src/main.ts"],
      "@meimu/mutracer/oidn": ["src/oidn.ts"]
    },
    "types": ["@webgpu/types", "vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "../tools/pbrt", "../scripts/pbrt-browser.ts"]
}
