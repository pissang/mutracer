#usda 1.0
(metersPerUnit = 1; upAxis = "Y")
# Two overlapping surfaces at known camera-forward distances (4 and 5).
# Their boundary and the outer silhouette must follow primId, independent of spp/DOF.
def Mesh "Back" {
    uniform bool doubleSided = true
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-1,-1,0), (1,-1,0), (1,1,0), (-1,1,0)]
}
def Mesh "Front" {
    uniform bool doubleSided = true
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.7,-0.6,1), (0.1,-0.6,1), (0.1,0.6,1), (-0.7,0.6,1)]
}
def DistantLight "Light" {
    float inputs:intensity = 1
}
def Camera "Camera" {
    float2 clippingRange = (0.1, 100)
    float focalLength = 50
    float horizontalAperture = 36
    float verticalAperture = 36
    double3 xformOp:translate = (0, 0, 5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
