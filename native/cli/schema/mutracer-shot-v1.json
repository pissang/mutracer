{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutracer.meimu-studio.com/schemas/mutracer-shot-v1.json",
  "title": "MuTracer shot v1",
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "output": {"$ref": "#/$defs/output"},
    "assets": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/asset"}
    },
    "environment": {"$ref": "#/$defs/environment"},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}, "minItems": 1, "maxItems": 65536},
    "lights": {"type": "array", "items": {"$ref": "#/$defs/light"}, "minItems": 0, "maxItems": 1024},
    "camera": {"$ref": "#/$defs/camera"}
  },
  "required": ["version", "output", "objects", "camera"],
  "additionalProperties": false,
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$"},
    "ease": {
      "oneOf": [
        {"enum": ["linear", "step", "inOutSine", "inOutQuad", "inOutCubic"]},
        {
          "type": "object",
          "properties": {
            "bezier": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "number", "minimum": 0, "maximum": 1}
              ],
              "minItems": 4,
              "items": false
            }
          },
          "required": ["bezier"],
          "additionalProperties": false
        }
      ]
    },
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "minItems": 3,
      "items": false
    },
    "color": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0}
      ],
      "minItems": 3,
      "items": false
    },
    "scale": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "minItems": 3,
      "items": false
    },
    "rotation": {
      "oneOf": [
        {"$ref": "#/$defs/point"},
        {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
          "minItems": 4,
          "items": false
        }
      ]
    },
    "scalarChannel": {
      "oneOf": [
        {"type": "number"},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number"}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "nonnegativeChannel": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "positiveChannel": {
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "signedUnitChannel": {
      "oneOf": [
        {"type": "number", "minimum": -1, "maximum": 1},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": -1, "maximum": 1}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "unitChannel": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0, "maximum": 1}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "iorChannel": {
      "oneOf": [
        {"type": "number", "minimum": 1},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 1}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "fovChannel": {
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "minimum": 0},
                  {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180}
                ],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "pointChannel": {
      "oneOf": [
        {"$ref": "#/$defs/point"},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/point"}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "colorChannel": {
      "oneOf": [
        {"$ref": "#/$defs/color"},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/color"}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "scaleChannel": {
      "oneOf": [
        {"$ref": "#/$defs/scale"},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/scale"}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "vec2Channel": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "items": false
        },
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "minimum": 0},
                  {
                    "type": "array",
                    "prefixItems": [
                      {"type": "number"},
                      {"type": "number"}
                    ],
                    "minItems": 2,
                    "items": false
                  }
                ],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "vec2PositiveChannel": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
          "minItems": 2,
          "items": false
        },
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "minimum": 0},
                  {
                    "type": "array",
                    "prefixItems": [
                      {"type": "number", "exclusiveMinimum": 0},
                      {"type": "number", "exclusiveMinimum": 0}
                    ],
                    "minItems": 2,
                    "items": false
                  }
                ],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "rotationChannel": {
      "oneOf": [
        {"$ref": "#/$defs/rotation"},
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/rotation"}],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "inputChannel": {
      "oneOf": [
        {
          "oneOf": [
            {"type": "number"},
            {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "minItems": 2,
              "items": false
            },
            {"$ref": "#/$defs/point"},
            {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
              "minItems": 4,
              "items": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "minimum": 0},
                  {
                    "oneOf": [
                      {"type": "number"},
                      {
                        "type": "array",
                        "prefixItems": [{"type": "number"}, {"type": "number"}],
                        "minItems": 2,
                        "items": false
                      },
                      {"$ref": "#/$defs/point"},
                      {
                        "type": "array",
                        "prefixItems": [
                          {"type": "number"},
                          {"type": "number"},
                          {"type": "number"},
                          {"type": "number"}
                        ],
                        "minItems": 4,
                        "items": false
                      }
                    ]
                  }
                ],
                "minItems": 2,
                "items": false
              },
              "minItems": 1,
              "maxItems": 100000
            },
            "ease": {"$ref": "#/$defs/ease", "default": "linear"}
          },
          "required": ["keys"],
          "additionalProperties": false
        }
      ]
    },
    "target": {"oneOf": [{"$ref": "#/$defs/name"}, {"$ref": "#/$defs/pointChannel"}]},
    "render": {
      "type": "object",
      "properties": {
        "bounces": {"type": "integer", "minimum": 1, "maximum": 20, "default": 6},
        "clamping": {"type": "number", "minimum": 0, "default": 0},
        "samplingPattern": {"enum": ["sobol", "zsobol", "random"], "default": "sobol"},
        "directLightCandidates": {"type": "integer", "minimum": 1, "maximum": 16, "default": 4},
        "dispersionWavelengths": {"enum": [1, 3], "default": 3},
        "bevel": {"type": "boolean", "default": true},
        "bevelSamples": {"type": "integer", "minimum": 1, "maximum": 32, "default": 8},
        "alphaBlendStrategy": {"enum": ["stochastic", "deterministic-source-over"], "default": "stochastic"},
        "transmissiveOutputAlphaMin": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
        "caustics": {
          "type": "object",
          "properties": {
            "lightTracing": {"type": "boolean", "default": false},
            "photonMapping": {"type": "boolean", "default": false},
            "lightPhotons": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 0},
            "photonMapPhotons": {"type": "integer", "minimum": 0, "maximum": 262144, "default": 0},
            "photonMapRadius": {"type": "number", "minimum": 0, "default": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "tonemap": {"enum": ["agx", "aces", "cineon", "linear", "reinhard", "none"], "default": "agx", "deprecated": true, "description": "Use toneMapping. Replace none with linear."},
        "toneMapping": {"enum": ["agx", "aces", "cineon", "linear", "reinhard"], "default": "agx"},
        "exposure": {"$ref": "#/$defs/scalarChannel", "default": 0, "deprecated": true, "description": "Use toneMappingExposure in linear units. For a constant exposure in stops, use 2 raised to that value."},
        "toneMappingExposure": {"$ref": "#/$defs/nonnegativeChannel", "default": 1}
      },
      "allOf": [
        {"not": {"required": ["tonemap", "toneMapping"]}},
        {"not": {"required": ["exposure", "toneMappingExposure"]}}
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "allOf": [{"if": {"required": ["denoise"], "properties": {"denoise": {"const": "temporal"}}}, "then": {"required": ["sampleSequence"], "properties": {"sampleSequence": {"const": "frame"}}}}],
      "properties": {
        "size": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1, "maximum": 8192},
            {"type": "integer", "minimum": 1, "maximum": 8192}
          ],
          "minItems": 2,
          "items": false,
          "default": [1280, 720]
        },
        "fps": {"type": "integer", "minimum": 1, "maximum": 240, "default": 24},
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Shot length in seconds, excluding the endpoint. The --frames CLI option selects one zero-based index or an inclusive index range at the effective fps."
        },
        "spp": {"type": "integer", "minimum": 1, "maximum": 16384, "default": 32},
        "seed": {"enum": ["fixed", "frame"], "default": "fixed"},
        "seedValue": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 12345},
        "sampleSequenceOffset": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 0},
        "sampleSequence": {"enum": ["fixed", "frame"], "default": "fixed"},
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "offline"
            },
            "historyRadius": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    }
                  }
                }
              ]
            },
            "postRadius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "stabilizeSparkle": {
              "type": "boolean"
            },
            "historyInvalidation": {
              "enum": [
                "auto",
                "manual"
              ]
            },
            "memoryBudget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cuts": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "time"
                    ],
                    "properties": {
                      "time": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "denoise": {"enum": ["oidn", "cleanAuxLarge", "none", "temporal"], "default": "oidn"},
        "render": {"$ref": "#/$defs/render"},
        "tracer": {
          "enum": ["hardware", "software"],
          "default": "hardware",
          "description": "Ray traversal. hardware uses GPU ray queries when available and otherwise software. The CLI --tracer option overrides it."
        },
        "display": {"$ref": "#/$defs/display"}
      },
      "required": ["duration"],
      "additionalProperties": false
    },
    "positionsSidecar": {
      "type": "object",
      "properties": {
        "file": {"$ref": "#/$defs/path"},
        "dtype": {"const": "f32"},
        "shape": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1, "maximum": 4000000}, {"const": 3}],
          "minItems": 2,
          "items": false
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 4,
          "default": 0
        }
      },
      "required": ["file", "dtype", "shape"],
      "additionalProperties": false
    },
    "uvSidecar": {
      "type": "object",
      "properties": {
        "file": {"$ref": "#/$defs/path"},
        "dtype": {"const": "f32"},
        "shape": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1, "maximum": 4000000}, {"const": 2}],
          "minItems": 2,
          "items": false
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 4,
          "default": 0
        }
      },
      "required": ["file", "dtype", "shape"],
      "additionalProperties": false
    },
    "indicesSidecar": {
      "type": "object",
      "properties": {
        "file": {"$ref": "#/$defs/path"},
        "dtype": {"const": "u32"},
        "shape": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 3, "maximum": 12000000, "multipleOf": 3}],
          "minItems": 1,
          "items": false
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 4,
          "default": 0
        }
      },
      "required": ["file", "dtype", "shape"],
      "additionalProperties": false
    },
    "instancesSidecar": {
      "type": "object",
      "properties": {
        "file": {"$ref": "#/$defs/path"},
        "dtype": {"const": "f32"},
        "shape": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1, "maximum": 16777216}, {"const": 16}],
          "minItems": 2,
          "items": false
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 4,
          "default": 0
        }
      },
      "required": ["file", "dtype", "shape"],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "positions": {
          "oneOf": [
            {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3, "maxItems": 10000},
            {"$ref": "#/$defs/positionsSidecar"}
          ]
        },
        "indices": {
          "oneOf": [
            {
              "type": "array",
              "items": {"type": "integer", "minimum": 0, "maximum": 9999},
              "minItems": 3,
              "maxItems": 30000
            },
            {"$ref": "#/$defs/indicesSidecar"}
          ]
        },
        "normals": {
          "oneOf": [
            {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3, "maxItems": 10000},
            {"$ref": "#/$defs/positionsSidecar"}
          ]
        },
        "uv": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number"}, {"type": "number"}],
                "minItems": 2,
                "items": false
              },
              "minItems": 3,
              "maxItems": 10000
            },
            {"$ref": "#/$defs/uvSidecar"}
          ]
        }
      },
      "required": ["positions", "indices"],
      "additionalProperties": false
    },
    "asset": {
      "oneOf": [
        {
          "type": "object",
          "properties": {"gltf": {"$ref": "#/$defs/path"}},
          "required": ["gltf"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"hdr": {"$ref": "#/$defs/path"}},
          "required": ["hdr"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"image": {"$ref": "#/$defs/path"}},
          "required": ["image"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"materialx": {"$ref": "#/$defs/path"}},
          "required": ["materialx"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "instances": {"$ref": "#/$defs/path"},
            "count": {"type": "integer", "minimum": 1, "maximum": 16777216}
          },
          "required": ["instances", "count"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"instances": {"$ref": "#/$defs/instancesSidecar"}},
          "required": ["instances"],
          "additionalProperties": false
        }
      ]
    },
    "material": {
      "type": "object",
      "properties": {
        "asset": {"$ref": "#/$defs/name"},
        "inputs": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/inputChannel"}
        },
