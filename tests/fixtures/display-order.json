  "exceptions": {
    "LinearHDRSurface": "Browser HDR is sRGB encoded; native HDR surfaces are linear scRGB. Decode browser RGB before comparing.",
    "WebGLSDROnly": "WebGL 2 exposes SDR presentation only; HDR rows are tested on WebGPU and native.",
    "WebGLJNLM": "WebGL JNLM composes in 8-bit display encoding, decodes for filtering and re-encodes; allow 2 codes for this smooth fixture.",
    "HalfFloatOutput": "Production browser resolve and HDR presentation use float16 (linear resolve, then sRGB surface); native surfaces are linear float16. Allow 2.5e-3 relative error across both roundings.",
    "WebGLSceneFilter": "WebGL has no custom scene-linear/OIDN filter; scene-filtered catcher rows require WebGPU/native.",
    "BrowserComposition": "WebGPU writes display-linear and encoded attachments together. Completing a filter recomposes before encoding; WebGL also recomposes when the separate filter request arrives.",
    "BrowserDiagnosticComposition": "Browser post-processing executes composition before selecting the raw diagnostic image; native selects diagnostics before composition.",
    "BrowserCustomSceneFilter": "Browser scene fixtures execute a custom scene-linear filter; native fixtures upload the same prefiltered image before composition.",
    "BrowserByteGuides": "Production browser normal/albedo resolve uses RGBA8; native HDR diagnostics retain float16. Allow 2.3e-3 absolute error (half an 8-bit code plus float16 rounding)."
  },
