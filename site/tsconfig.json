{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types",
      "vite/client",
      "node"
    ],
    "baseUrl": "..",
    "paths": {
      "@meimu/mutracer": [
        "src/main.ts"
      ],
      "@meimu/mutracer/oidn": [
        "src/oidn.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "src/worker.ts",
    "src/worker-env.d.ts"
  ]
}
